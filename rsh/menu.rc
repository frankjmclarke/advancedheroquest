#include <windows.h>
#include "../version.h"
#include "menu.rh"

#define DIALOG_FONT 10, "MS Sans Serif"

#define MENU_HELP_BASE 1000

/* not present in the Borland C++ 4.52 headers */
#ifndef VK_OEM_PLUS
#  define VK_OEM_PLUS 0xBB
#endif
#ifndef VK_OEM_MINUS
#  define VK_OEM_MINUS 0xBD
#endif


#ifndef WS_OVERLAPPED
#  define WS_OVERLAPPED 0
#endif
#ifndef DS_3DLOOK
#  define DS_3DLOOK 0x04
#endif


MENUE MENU
{
	POPUP "&File"
	{
		MENUITEM "&Save...\tCtrl+S", MSPEICH
		MENUITEM "&Print\tCtrl+P", MDRUCK
		MENUITEM "&Close\tCtrl+U", MSCHLIES
		MENUITEM "Close &All\tCtrl+X", MALLESCH
		MENUITEM "&Next Window\tCtrl+W", MWECHSEL
		MENUITEM SEPARATOR
		MENUITEM "E&xit...\tCtrl+Q", MENDE
	}
	POPUP "&Map"
	{
		MENUITEM "&Generate Map...\tCtrl+K", MKARTE, GRAYED
		MENUITEM "&Next Map\tCtrl+N", MWEITER, GRAYED
		MENUITEM "S&ave Map...\tCtrl+A", MABSPEIC, GRAYED
		MENUITEM SEPARATOR
		MENUITEM "G&raphic Map\tAlt+G", MGRAFIK, GRAYED
		MENUITEM "&Player View (fog of war)\tAlt+W", MPLAYER, GRAYED
		MENUITEM "&Text Map\tAlt+T", MTEXT, GRAYED
		MENUITEM "&Monster List\tAlt+M", MMONSTER, GRAYED
		MENUITEM "Room &Statistics\tAlt+S", MSTATIST, GRAYED
	}
	POPUP "&Options"
	{
		MENUITEM "Load &Tables...\tCtrl+T", MTABELLE
		MENUITEM SEPARATOR
		MENUITEM "&Program Parameters...\tAlt+P", MPARA
		MENUITEM SEPARATOR
		MENUITEM "&Editor Path...\tAlt+E", MEPFAD
		MENUITEM "Launch E&ditor\tCtrl+E", MEDITOR
		MENUITEM SEPARATOR
		MENUITEM "Save Options", MSAVEOPT
	}
	POPUP "&View"
	{
		MENUITEM "Zoom &In\tCtrl++", MZOOMIN
		MENUITEM "Zoom &Out\tCtrl+-", MZOOMOUT
		MENUITEM "&Actual Size\tCtrl+0", MZOOM100
		MENUITEM SEPARATOR
		MENUITEM "&Fit to Window\tCtrl+9", MZOOMFIT
	}
	POPUP "&Help", HELP
	{
		MENUITEM "&How to use HQ-Map\tF1", MHELP
		MENUITEM SEPARATOR
		MENUITEM "&About HQ-Map...\tAlt+I", MINFO
	}
}


MENUE ACCELERATORS
{
	"^S", MSPEICH, ASCII
	"^P", MDRUCK, ASCII
	"^U", MSCHLIES, ASCII
	"^X", MALLESCH, ASCII
	"^W", MWECHSEL, ASCII
	"^Q", MENDE, ASCII
	"^K", MKARTE, ASCII
	"^N", MWEITER, ASCII
	"^A", MABSPEIC, ASCII
	"g", MGRAFIK, ASCII, ALT
	"w", MPLAYER, ASCII, ALT
	"t", MTEXT, ASCII, ALT
	"m", MMONSTER, ASCII, ALT
	"s", MSTATIST, ASCII, ALT
	"^T", MTABELLE, ASCII
	"p", MPARA, ASCII, ALT
	"e", MEPFAD, ASCII, ALT
	"^E", MEDITOR, ASCII
	VK_F1, MHELP, VIRTKEY
	VK_HELP, MHELP, VIRTKEY
	"i", MINFO, ASCII, ALT
	"0", MZOOM100, VIRTKEY, CONTROL
	"9", MZOOMFIT, VIRTKEY, CONTROL
	VK_ADD, MZOOMIN, VIRTKEY, CONTROL
	VK_SUBTRACT, MZOOMOUT, VIRTKEY, CONTROL
	VK_OEM_PLUS, MZOOMIN, VIRTKEY, CONTROL
	VK_OEM_MINUS, MZOOMOUT, VIRTKEY, CONTROL
	/* On a US layout the plus key is Shift plus the equals key, so what
	   the menu calls Ctrl-plus actually arrives as Ctrl+Shift+equals.
	   An accelerator that does not name SHIFT only matches with shift
	   up, so the shifted form has to be bound as well or the exact key
	   combination printed in the menu does nothing at all. */
	VK_OEM_PLUS, MZOOMIN, VIRTKEY, CONTROL, SHIFT
	VK_OEM_MINUS, MZOOMOUT, VIRTKEY, CONTROL, SHIFT
}


FKARTE DIALOG 0, 0, 276, 148
STYLE DS_MODALFRAME | DS_3DLOOK | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Generate Map"
FONT DIALOG_FONT
{
 CONTROL "Map Name: ", -1, "STATIC", SS_LEFTNOWORDWRAP | WS_CHILD | WS_VISIBLE | WS_GROUP, 12, 12, 52, 8
 EDITTEXT KNAME, 63, 10, 202, 12, ES_AUTOHSCROLL | WS_TABSTOP | WS_BORDER
 CONTROL "Width: ", -1, "STATIC", SS_LEFTNOWORDWRAP | WS_CHILD | WS_VISIBLE | WS_GROUP, 12, 28, 32, 8
 EDITTEXT KX, 43, 26, 14, 12, ES_AUTOHSCROLL | WS_TABSTOP | WS_BORDER
 LTEXT "  x  ", 4, 58, 28, 20, 8, WS_VISIBLE
 CONTROL "Height: ", -1, "STATIC", SS_LEFTNOWORDWRAP | WS_CHILD | WS_VISIBLE | WS_GROUP, 74, 28, 28, 8
 EDITTEXT KY, 103, 26, 14, 12, ES_AUTOHSCROLL | WS_TABSTOP | WS_BORDER
 LTEXT "0000", KXCM, 120, 28, 16, 8, WS_VISIBLE
 LTEXT " cm  x  ", 7, 136, 28, 32, 8, WS_VISIBLE
 LTEXT "0000", KYCM, 168, 28, 16, 8, WS_VISIBLE
 LTEXT " cm", 9, 184, 28, 12, 8, WS_VISIBLE
 CONTROL "Entrance:", -1, "STATIC", SS_LEFTNOWORDWRAP | WS_CHILD | WS_VISIBLE | WS_GROUP, 12, 44, 48, 8
 EDITTEXT 10, 60, 44, 0, 8, ES_AUTOHSCROLL | WS_TABSTOP | ES_READONLY
 CONTROL "X: ", -1, "STATIC", SS_LEFTNOWORDWRAP | WS_CHILD | WS_VISIBLE | WS_GROUP, 116, 44, 12, 8
 EDITTEXT KEX, 130, 42, 14, 12, ES_AUTOHSCROLL | WS_TABSTOP | WS_BORDER
 CONTROL " / ", -1, "STATIC", SS_LEFTNOWORDWRAP | WS_CHILD | WS_VISIBLE | WS_GROUP, 149, 44, 12, 8
 EDITTEXT 13, 132, 44, 0, 8, ES_AUTOHSCROLL | WS_TABSTOP | ES_READONLY
 CONTROL "Y: ", -1, "STATIC", SS_LEFTNOWORDWRAP | WS_CHILD | WS_VISIBLE | WS_GROUP, 158, 44, 12, 8
 EDITTEXT KEY, 173, 41, 14, 12, ES_AUTOHSCROLL | WS_TABSTOP | WS_BORDER
 CONTROL "Random number seed: ", -1, "STATIC", SS_LEFTNOWORDWRAP | WS_CHILD | WS_VISIBLE | WS_GROUP, 12, 60, 124, 8
 EDITTEXT KZUFALL, 135, 58, 34, 12, ES_AUTOHSCROLL | WS_TABSTOP | WS_BORDER
 CHECKBOX "&Always generate stairs down", KIMMER, 12, 76, 148, 8, BS_AUTOCHECKBOX | WS_VISIBLE
 CHECKBOX "&Only one staircase", KNUREINE, 12, 92, 108, 8, BS_AUTOCHECKBOX | WS_VISIBLE
 CHECKBOX "Only show maps &with stairs down", KWEITER, 12, 108, 164, 8, BS_AUTOCHECKBOX | WS_VISIBLE
 PUSHBUTTON "Ne&xt", KNAECHST, 10, 124, 52, 16, BS_PUSHBUTTON | WS_TABSTOP | WS_VISIBLE
 DEFPUSHBUTTON "&OK", KOK, 158, 124, 52, 16, BS_DEFPUSHBUTTON | WS_TABSTOP | WS_VISIBLE
 PUSHBUTTON "&Cancel", KABBR, 218, 124, 52, 16, BS_PUSHBUTTON | WS_TABSTOP | WS_VISIBLE
 COMBOBOX KPOS, 59, 42, 47, 57, CBS_DROPDOWNLIST | WS_TABSTOP
}


