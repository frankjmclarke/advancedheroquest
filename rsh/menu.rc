FHELP DIALOG 0, 0, 320, 300
STYLE DS_MODALFRAME | DS_3DLOOK | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "How to use HQ-Map"
FONT DIALOG_FONT
{
 LTEXT "HQ-Map rolls a random dungeon for Advanced HeroQuest and draws the map.", -1, 12, 10, 300, 8, WS_VISIBLE
 LTEXT "It opens with a dungeon already generated. Everything below is optional.", -1, 12, 22, 300, 8, WS_VISIBLE

 LTEXT "Dungeons", -1, 12, 42, 100, 8, WS_VISIBLE
 LTEXT "Ctrl+N", -1, 24, 56, 56, 8, WS_VISIBLE
 LTEXT "Roll a different dungeon", -1, 88, 56, 220, 8, WS_VISIBLE
 LTEXT "Ctrl+K", -1, 24, 68, 56, 8, WS_VISIBLE
 LTEXT "Choose the size, entrance and random seed, then roll", -1, 88, 68, 220, 8, WS_VISIBLE
 LTEXT "Ctrl+T", -1, 24, 80, 56, 8, WS_VISIBLE
 LTEXT "Load a different quest", -1, 88, 80, 220, 8, WS_VISIBLE

 LTEXT "Looking at the map", -1, 12, 100, 120, 8, WS_VISIBLE
 LTEXT "Ctrl+9", -1, 24, 114, 56, 8, WS_VISIBLE
 LTEXT "Fit the whole map in the window", -1, 88, 114, 220, 8, WS_VISIBLE
 LTEXT "Ctrl and +", -1, 24, 126, 56, 8, WS_VISIBLE
 LTEXT "Zoom in", -1, 88, 126, 220, 8, WS_VISIBLE
 LTEXT "Ctrl and -", -1, 24, 138, 56, 8, WS_VISIBLE
 LTEXT "Zoom out", -1, 88, 138, 220, 8, WS_VISIBLE
 LTEXT "Ctrl+0", -1, 24, 150, 56, 8, WS_VISIBLE
 LTEXT "Back to actual size", -1, 88, 150, 220, 8, WS_VISIBLE

 LTEXT "Other views", -1, 12, 170, 120, 8, WS_VISIBLE
 LTEXT "Alt+M", -1, 24, 184, 56, 8, WS_VISIBLE
 LTEXT "Monster list: what waits in each numbered room", -1, 88, 184, 220, 8, WS_VISIBLE
 LTEXT "Alt+S", -1, 24, 196, 56, 8, WS_VISIBLE
 LTEXT "Room statistics", -1, 88, 196, 220, 8, WS_VISIBLE
 LTEXT "Alt+T", -1, 24, 208, 56, 8, WS_VISIBLE
 LTEXT "The map written out as text", -1, 88, 208, 220, 8, WS_VISIBLE

 LTEXT "Saving and printing", -1, 12, 228, 120, 8, WS_VISIBLE
 LTEXT "Ctrl+A", -1, 24, 242, 56, 8, WS_VISIBLE
 LTEXT "Save the map as a picture (black and white)", -1, 88, 242, 220, 8, WS_VISIBLE
 LTEXT "Ctrl+P", -1, 24, 254, 56, 8, WS_VISIBLE
 LTEXT "Print the map", -1, 88, 254, 220, 8, WS_VISIBLE

 LTEXT "Rooms are numbered on the map. Press Alt+M to see what is in each one.", -1, 12, 272, 300, 8, WS_VISIBLE

 DEFPUSHBUTTON "&OK", IDOK, 134, 284, 52, 14, BS_DEFPUSHBUTTON | WS_TABSTOP | WS_VISIBLE
}


