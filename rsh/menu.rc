FILETYPE VFT_APP
{
 BLOCK "StringFileInfo"
 {
  BLOCK "040904E4"
  {
   VALUE "CompanyName", "J�rgen Albuschies\000"
   VALUE "FileDescription", "Advanced Hero Quest Map Generator\000"
   VALUE "FileVersion", AHQ_MAP_VERSION "\000"
