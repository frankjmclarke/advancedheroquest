#include <windows.h>
#include "../version.h"
#include "menu.rh"

#define DIALOG_FONT 10, "MS Sans Serif"

#define MENU_HELP_BASE 1000


#ifndef WS_OVERLAPPED
#  define WS_OVERLAPPED 0
#endif
#ifndef DS_3DLOOK
#  define DS_3DLOOK 0x04
#endif


MENUE MENU
{
	POPUP "&Datei"
	{
		MENUITEM "&Speichern...\tCtrl+S", MSPEICH
		MENUITEM "&Drucken\tCtrl+P", MDRUCK
		MENUITEM "S&chlie\337en\tCtrl+U", MSCHLIES
		MENUITEM "&Alle schlie\337en\tCtrl+X", MALLESCH
		MENUITEM "&N\344chstes Fenster\tCtrl+W", MWECHSEL
		MENUITEM SEPARATOR
		MENUITEM "&Programmende...\tCtrl+Q", MENDE
	}
	POPUP "&Karte"
	{
		MENUITEM "&Karte erzeugen...\tCtrl+K", MKARTE, GRAYED
		MENUITEM "&N\344chste Karte\tCtrl+N", MWEITER, GRAYED
		MENUITEM "K&arte abspeichern...\tCtrl+A", MABSPEIC, GRAYED
		MENUITEM SEPARATOR
		MENUITEM "&Grafik-Karte\tAlt+G", MGRAFIK, GRAYED
		MENUITEM "&Text-Karte\tAlt+T", MTEXT, GRAYED
		MENUITEM "&Monster-Liste\tAlt+M", MMONSTER, GRAYED
		MENUITEM "&Raum-Statistik\tAlt+S", MSTATIST, GRAYED
	}
	POPUP "&Optionen"
	{
		MENUITEM "&Tabellen einlesen...\tCtrl+T", MTABELLE
		MENUITEM SEPARATOR
		MENUITEM "&Programm Parameter...\tAlt+P", MPARA
		MENUITEM SEPARATOR
		MENUITEM "&Editor-Pfad...\tAlt+E", MEPFAD
		MENUITEM "E&ditor aufrufen\tCtrl+E", MEDITOR
		MENUITEM SEPARATOR
		MENUITEM "Optionen sichern", MSAVEOPT
	}
	POPUP "&Help", HELP
	{
#ifdef MENU_HELP_BASE
		MENUITEM "&Contents", MENU_HELP_BASE
		MENUITEM "&Search...", MENU_HELP_BASE+1
		MENUITEM "&Using\tHelp", MENU_HELP_BASE+2
		MENUITEM SEPARATOR
#endif /* MENU_HELP_BASE */
		MENUITEM "&Info...\tAlt+I", MINFO
	}
}


MENUE ACCELERATORS
{
	"^S", MSPEICH, ASCII
	"^P", MDRUCK, ASCII
	"^U", MSCHLIES, ASCII
	"^X", MALLESCH, ASCII
	"^W", MWECHSEL, ASCII
	"^Q", MENDE, ASCII
	"^K", MKARTE, ASCII
	"^N", MWEITER, ASCII
	"^A", MABSPEIC, ASCII
	"g", MGRAFIK, ASCII, ALT
	"t", MTEXT, ASCII, ALT
	"m", MMONSTER, ASCII, ALT
	"s", MSTATIST, ASCII, ALT
	"^T", MTABELLE, ASCII
	"p", MPARA, ASCII, ALT
	"e", MEPFAD, ASCII, ALT
	"^E", MEDITOR, ASCII
	VK_HELP, MENU_HELP_BASE+2, VIRTKEY
	"i", MINFO, ASCII, ALT
}


