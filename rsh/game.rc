    PUSHBUTTON "Remove",GMREMOVE,10,192,65,18
    PUSHBUTTON "Room contents",GMCONTENTS,82,192,92,18
    LTEXT "",GMINFO,10,216,325,24
    DEFPUSHBUTTON "Close",IDOK,350,218,70,18
END

