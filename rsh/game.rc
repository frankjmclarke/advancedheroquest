FGCOMBAT DIALOGEX 0,0,470,350
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Hand-to-hand combat"
FONT 9,"Segoe UI"
BEGIN
    LTEXT "",MCINFO,10,10,450,57
    PUSHBUTTON "Hero profile",MCHERO,10,70,100,18
    PUSHBUTTON "Monster profile",MCMONSTER,120,70,100,18
    LTEXT "Hit D12",-1,10,103,65,12
    EDITTEXT MCHIT,75,100,42,18,ES_NUMBER | ES_READONLY
    PUSHBUTTON "Roll attack",MCROLLHIT,127,100,100,18
    LTEXT "Damage rolls (bonus dice are rolled automatically)",-1,10,128,450,12
    EDITTEXT MCDAMAGE,10,144,450,32,ES_READONLY | ES_MULTILINE | ES_AUTOVSCROLL | WS_VSCROLL
    PUSHBUTTON "Take free attack",MCNEXT,10,186,110,18
    LTEXT "",MCSTATUS,130,183,330,32
    EDITTEXT MCLOG,10,220,450,70,ES_MULTILINE | ES_READONLY | WS_VSCROLL
    LTEXT "Preview only until Apply. Turn limits, special abilities, reach and other modifiers are adjudicated by the players.",-1,10,297,450,25
    DEFPUSHBUTTON "Apply",IDOK,290,326,80,18
    PUSHBUTTON "Cancel",IDCANCEL,380,326,80,18
END

FGRANGEDPROFILE DIALOGEX 0,0,440,230
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Ranged weapon profile"
FONT 9,"Segoe UI"
BEGIN
    LTEXT "Weapon",-1,10,10,200,12
    EDITTEXT RPWEAPON,10,24,220,18,ES_AUTOHSCROLL
    LTEXT "Type",-1,240,10,190,12
    COMBOBOX RPKIND,240,24,190,100,CBS_DROPDOWNLIST | WS_TABSTOP | WS_VSCROLL
    LTEXT "Maximum range",-1,10,52,100,12
    EDITTEXT RPRANGE,110,49,50,18,ES_NUMBER
    LTEXT "Damage D12",-1,180,52,80,12
    EDITTEXT RPDICE,260,49,50,18,ES_NUMBER
    CONTROL "Moved this turn",RPMOVED,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,320,50,110,18
    LTEXT "Required hit by distance (orthogonal square count):",-1,10,81,420,12
    LTEXT "1-3",-1,10,100,60,12
    LTEXT "4-12",-1,95,100,60,12
    LTEXT "13-24",-1,180,100,60,12
    LTEXT "25-36",-1,265,100,60,12
    LTEXT "37+",-1,350,100,60,12
    EDITTEXT 424,10,114,65,18,ES_NUMBER
    EDITTEXT 425,95,114,65,18,ES_NUMBER
    EDITTEXT 426,180,114,65,18,ES_NUMBER
    EDITTEXT 427,265,114,65,18,ES_NUMBER
    EDITTEXT 428,350,114,65,18,ES_NUMBER
    PUSHBUTTON "Load default / reference",RPDEFAULT,10,151,145,18
    LTEXT "",RPINFO,165,145,265,40
    LTEXT "None disables ranged attacks. Zero hit entries need configuration. Other: movement is adjudicated manually.",-1,10,182,420,25
    DEFPUSHBUTTON "Save profile",IDOK,260,207,80,18
    PUSHBUTTON "Cancel",IDCANCEL,350,207,80,18
END

