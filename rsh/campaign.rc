#include "campaign.rh"
FCB DIALOGEX 0, 0, 460, 368
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Campaign Builder"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Start &from:", -1, 12, 14, 66, 12
    COMBOBOX CBBASE, 82, 11, 300, 180, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON "&Refresh", CBREFRESH, 389, 11, 58, 15
    LTEXT "Campaign &title:", -1, 12, 39, 68, 12
    EDITTEXT CBTITLE, 82, 36, 365, 15, ES_AUTOHSCROLL
    LTEXT "Folder &name:", -1, 12, 61, 68, 12
    EDITTEXT CBSLUG, 82, 58, 170, 15, ES_AUTOHSCROLL
    LTEXT "Letters and hyphens; e.g. goblinfort", -1, 259, 61, 190, 12
    LTEXT "Rooms/layout:", -1, 12, 90, 68, 12
    COMBOBOX 210, 82, 87, 300, 180, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON "View", 220, 389, 87, 58, 15
    LTEXT "Monsters:", -1, 12, 112, 68, 12
    COMBOBOX 211, 82, 109, 300, 180, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON "View", 221, 389, 109, 58, 15
    LTEXT "Hazards:", -1, 12, 134, 68, 12
    COMBOBOX 212, 82, 131, 300, 180, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON "View", 222, 389, 131, 58, 15
    LTEXT "Furnishings:", -1, 12, 156, 68, 12
    COMBOBOX 213, 82, 153, 300, 180, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON "View", 223, 389, 153, 58, 15
    LTEXT "Traps:", -1, 12, 178, 68, 12
    COMBOBOX 214, 82, 175, 300, 180, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON "View", 224, 389, 175, 58, 15
    LTEXT "Treasure:", -1, 12, 200, 68, 12
    COMBOBOX 215, 82, 197, 300, 180, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON "View", 225, 389, 197, 58, 15
    CONTROL "Include room &furnishings", CBFURNISH, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 82, 219, 260, 13
    LTEXT "Campaign &description:", -1, 12, 241, 200, 12
    EDITTEXT CBDESC, 12, 256, 435, 55, ES_MULTILINE | ES_AUTOVSCROLL | ES_WANTRETURN | WS_VSCROLL
    LTEXT "", CBSTATUS, 12, 316, 435, 17
    PUSHBUTTON "&Check Campaign", CBCHECK, 12, 341, 94, 17
    DEFPUSHBUTTON "&Create Campaign", CBCREATE, 267, 341, 100, 17
    PUSHBUTTON "Cancel", IDCANCEL, 377, 341, 70, 17
END
FCBPREVIEW DIALOGEX 0, 0, 480, 340
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Campaign Preview"
FONT 9, "Segoe UI"
BEGIN
    EDITTEXT CBPREVIEWTEXT, 10, 10, 460, 296, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | ES_AUTOHSCROLL | WS_VSCROLL | WS_HSCROLL
    DEFPUSHBUTTON "Close", IDOK, 400, 315, 70, 17
END
