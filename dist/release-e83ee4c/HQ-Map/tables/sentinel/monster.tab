    1-4     "Chaos Space Marine with Heavy Bolter (30 Points)"
    5-8     "Chaos Space Marine with Missile Launcher (35 Points)"
    9-11    "Chaos Space Marine with Heavy Bolter (40 Points)" & Xenos-Wargear()
   12-12    "Chaos Space Marine with Missile Launcher (45 Points)" & Xenos-Wargear()
)

Chaos-Space-Marine-Commander
(   1D12
    1-4     "Chaos Space Marine Commander (50 Points)"
    5-8     "Chaos Space Marine Commander (60 Points)" & Xenos-Wargear()
    9-11    "Chaos Space Marine Commander (80 Points)" & Xenos-Wargear()
   12-12    "Chaos Space Marine Commander (100 Points)" & Xenos-Wargear() & Rare-Equipment()
