(   1D12
    1-1     "5 Orks, 2 Chaos Androids (100 Points)" & Specialist-Xenos()
    2-2     "4 Chaos Androids, 4 Orks (110 Points)" & Specialist-Xenos()
    3-3     "6 Orks, 2 Ork Heavy Weapons (120 Points)" & Specialist-Xenos()
    4-4     "5 Chaos Androids, 3 Orks (130 Points)" & Specialist-Xenos()
    5-5     "4 Orks, 3 Chaos Androids, 6 Gretchin (140 Points)" & Specialist-Xenos()
    6-6     "6 Orks, 3 Ork Heavy Weapons (150 Points)" & Specialist-Xenos()
    7-7     "6 Chaos Androids, 4 Orks (180 Points)" & Specialist-Xenos-Double()
    8-8     "8 Orks, 2 Ork Heavy Weapons, 4 Gretchin (190 Points)" & Specialist-Xenos-Double()
    9-9     "4 Chaos Androids, 6 Orks, 2 Ork Heavy Weapons (200 Points)" & Specialist-Xenos-Double()
   10-10    "1 Dreadnought, 4 Orks (220 Points)" & Specialist-Xenos-Double()
   11-11    "1 Dreadnought, 4 Chaos Androids, 4 Gretchin (240 Points)" & Specialist-Xenos-Double()
   12-12    "1 Dreadnought, 6 Orks, 4 Chaos Androids (280 Points)" & Specialist-Xenos-Double()
)

Specialist-Xenos
(   1D12
    1-4     Ork-Nob()
    5-7     Ork-Heavy-Weapon()
    8-10    Chaos-Android()
   11-12    Ork-Nob()
)

Specialist-Xenos-Double
(   1D12
    1-3     Ork-Nob() & Ork-Heavy-Weapon()
    4-6     Ork-Nob() & Chaos-Android()
    7-9     Ork-Nob() & Ork-Nob()
   10-11    Ork-Nob() & Ork-Heavy-Weapon() & Chaos-Android()
