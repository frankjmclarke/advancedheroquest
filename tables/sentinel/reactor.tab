   12-12    "12 Genestealers, 1 Advanced Dreadnought (360 Points)" & Specialist-Xenos-Double()
)

Specialist-Xenos
(   1D12
    1-4     Genestealer()
    5-7     Chaos-Android()
    8-10    Dreadnought()
   11-12    Genestealer()
)

Specialist-Xenos-Double
(   1D12
    1-3     Genestealer() & Genestealer()
    4-6     Dreadnought() & Genestealer()
    7-9     Genestealer() & Chaos-Android()
   10-11    Dreadnought() & Dreadnought()
