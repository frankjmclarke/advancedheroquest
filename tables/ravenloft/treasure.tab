Hidden-Treasure
(   2D12
    2-6     "Hidden Treasure:" & "1 Dungeon-Counter"
    7-16    Nothing
   17-23    "Hidden Treasure:" & Gold-Treasure()
   24-24    "Hidden Treasure:" & Magic-Treasure()
)

Gold-Treasure
(   1D12
    1-1     "5 Gold Crowns"
    2-2     "10 Gold Crowns"
    3-3     "15 Gold Crowns"
    4-4     "20 Gold Crowns"
    5-5     "25 Gold Crowns"
    6-6     "30 Gold Crowns"
    7-7     "35 Gold Crowns"
    8-8     "40 Gold Crowns"
    9-9     "45 Gold Crowns"
    10-10   "50 Gold Crowns"
    11-11   "55 Gold Crowns"
    12-12   "60 Gold Crowns"
)

Magic-Treasure
(   2D12
    2-2     Dawnstone()
    3-3     Amulet()
    4-4     Magic-Bag()
    5-6     Magic-Wand()
    7-7     Magic-Ring()
    8-8     Shield-or-Helm()
   9-9      Magic-Weapon()
   10-11    Magical-Scroll()
   12-12    Jewel()
   13-14    Magic-Potion()
   15-15    Arrows-or-Bolts()
