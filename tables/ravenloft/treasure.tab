Magic-Bag
(   1D12
    1-3     "Bag of Lightness"
    4-6     "Bag of Treasure"
    7-9     & ;Bag of Wizardry
            (   1D12
                1-1     "Bag of Wizardry (1 Spell Component)"
                2-2     "Bag of Wizardry (2 Spell Component)"
                3-3     "Bag of Wizardry (3 Spell Component)"
